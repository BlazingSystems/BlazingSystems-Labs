<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="3dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/blaze_outline"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">
        <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumbnail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BlazeFM.Thumbnail"/>
            <ImageView
                android:id="@+id/file_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="11dp"
                android:background="@drawable/bg_icon_container"
                android:contentDescription="@null"
                app:tint="@color/blaze_primary"/>
            <ImageView
                android:id="@+id/selected_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="11dp"
                android:background="@drawable/bg_selected_container"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/blaze_on_primary_container"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/blaze_on_surface"/>
            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/blaze_on_surface_variant"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/more"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="File actions"
            app:icon="@drawable/ic_more_vert"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>