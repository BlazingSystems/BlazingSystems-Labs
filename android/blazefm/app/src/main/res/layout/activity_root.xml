<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blaze_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/root_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Root Browser"
        app:subtitle="Privileged filesystem access" />

    <TextView
        android:id="@+id/root_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:ellipsize="start"
        android:text="/"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/blaze_on_surface_variant" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp">
            <com.google.android.material.chip.Chip android:id="@+id/root_up" style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Up" app:chipIcon="@drawable/ic_arrow_up" app:chipIconVisible="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/root_go" style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Go to path" app:chipIcon="@drawable/ic_edit" app:chipIconVisible="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/root_refresh" style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refresh" app:chipIcon="@drawable/ic_refresh" app:chipIconVisible="true"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/root_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/blaze_on_surface_variant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/root_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp" />
</LinearLayout>