<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/blaze_surface_variant"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/blaze_primary_container"
    app:strokeWidth="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">
        <FrameLayout android:layout_width="92dp" android:layout_height="92dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumbnail"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BlazeFM.Thumbnail"/>
            <ImageView
                android:id="@+id/file_icon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:padding="26dp"
                android:background="@drawable/bg_icon_container"
                android:contentDescription="@null"
                app:tint="@color/blaze_primary"/>
            <ImageView
                android:id="@+id/selected_icon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:padding="26dp"
                android:background="@drawable/bg_selected_container"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/blaze_on_primary_container"/>
        </FrameLayout>
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/blaze_on_surface"/>
        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/blaze_on_surface_variant"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>