<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.blazefm.blazesystems"
    android:versionCode="11"
    android:versionName="1.1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="35" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher"
        android:label="BlazeFM"
        android:largeHeap="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true" >
        <provider
            android:name="com.blazefm.blazesystems.BlazeProvider"
            android:authorities="com.blazefm.blazesystems.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name="com.blazefm.blazesystems.PreviewActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.AnalyzerActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.AppManagerActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.CloudActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.CloudBrowserActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.RemoteActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.RootActivity"
            android:exported="false" />
        <activity
            android:name="com.blazefm.blazesystems.MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>